   }
 });
+
+// ===========================
+// TOLERANCE SCOPING (M10 regression):
+// decimal-tolerance must not be over-applied to exact answers
+// ===========================
+
+describe('tolerance scoping (M10 regression)', () => {
+  it('circles: diameter is graded exactly; circumference/area still accept true-π answers', () => {
+    let sawDiameter = false;
+    let sawPiBased = false;
+
+    for (let i = 0; i < 40; i++) {
+      const p = generateProblem('circles');
+      const ans = p.correctAnswer as number;
+
+      if (/diameter/i.test(p.problemText)) {
+        sawDiameter = true;
+        // d = 2r is an exact integer — no tolerance should apply
+        expect(p.answerType).toBe('numeric');
+        expect(validateAnswer(p, String(ans))).toBe(true);
+        expect(validateAnswer(p, String(ans + 0.4))).toBe(false);
+      } else {
+        sawPiBased = true;
+        // π-based subtypes keep the 0.5 tolerance (π vs 3.14)
+        expect(p.answerType).toBe('decimal-tolerance');
+        expect(p.tolerance).toBe(0.5);
+        const match = p.problemText.match(/radius \$(\d+)\$/);
+        if (!match) throw new Error(`Could not parse radius: ${p.problemText}`);
+        const r = parseInt(match[1]);
+        const truePiAnswer = /circumference/i.test(p.problemText)
+          ? 2 * Math.PI * r
+          : Math.PI * r * r;
+        expect(validateAnswer(p, String(truePiAnswer))).toBe(true);
+        expect(validateAnswer(p, String(ans))).toBe(true);
+      }
+    }
+
+    expect(sawDiameter).toBe(true);
+    expect(sawPiBased).toBe(true);
+  });
+
+  it('integration-applications: surface-area tolerance is tight enough to reject wrong answers', () => {
+    let sawSurfaceArea = false;
+
+    for (let i = 0; i < 60; i++) {
+      const p = generateProblem('integration-applications');
+      if (!/surface area/i.test(p.problemText)) continue;
+      sawSurfaceArea = true;
+
+      const ans = p.correctAnswer as number;
+      // Honest precision spread (π vs 3.14 at a ≤ 4) is ~0.04, so ±0.05 suffices
+      expect(validateAnswer(p, String(ans))).toBe(true);
+      expect(validateAnswer(p, (ans + 0.03).toFixed(2))).toBe(true);
+      // A flatly wrong answer must be rejected (was accepted under tolerance 0.5)
+      expect(validateAnswer(p, (ans + 0.4).toFixed(2))).toBe(false);
+    }
+
+    expect(sawSurfaceArea).toBe(true);
+  });
+});
